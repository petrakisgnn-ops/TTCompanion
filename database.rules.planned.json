{
  "rules": {
    ".read": false,
    ".write": false,

    "lobbies": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('dmUid').val() === auth.uid) || (data.exists() && data.child('dmUid').val() === auth.uid))",
        ".validate": "$code.matches(/^[0-9]{5}$/) && newData.hasChildren(['dmUid', 'dmName', 'status', 'createdAt'])",

        "dmUid":     { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "dmName":    { ".validate": "newData.isString() && newData.val().length <= 40" },
        "status":    { ".validate": "newData.isString() && (newData.val() === 'open' || newData.val() === 'closed')" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now" },

        "players": {
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && (!newData.exists() || root.child('lobbies/' + $code + '/status').val() === 'open')",
            ".validate": "newData.hasChildren(['uid', 'name', 'joinedAt'])",

            "uid":      { ".validate": "newData.isString() && newData.val() === auth.uid" },
            "name":     { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "online":   { ".validate": "newData.isBoolean()" },

            "character": {
              ".validate": "newData.hasChildren(['name', 'race', 'classes', 'level', 'hp', 'ac'])",
              "name":    { ".validate": "newData.isString() && newData.val().length <= 60" },
              "race":    { ".validate": "newData.isString() && newData.val().length <= 40" },
              "classes": { ".validate": "newData.isString() && newData.val().length <= 60" },
              "level":   { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20" },
              "ac":      { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99" },
              "hp": {
                ".validate": "newData.hasChildren(['current', 'max'])",
                "current":  { ".validate": "newData.isNumber() && newData.val() >= -999 && newData.val() <= 9999" },
                "max":      { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999" },
                "$other":   { ".validate": false }
              },
              "$other": { ".validate": false }
            },

            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
